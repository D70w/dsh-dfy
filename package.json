{
  "name": "dsh-dfy",
  "description": "A low-interruption Big Fat Fish companion plugin for the DeepSeek Harness web workspace",
  "version": "0.1.3",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -b && tsdown",
    "clean": "node scripts/clean.mjs",
    "prepare": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.test.json --pretty false",
    "verify": "npm run typecheck && npm run test && npm run build && npm pack --dry-run"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/index.d.ts",
    "lib/types/invariant.d.ts",
    "lib/types/preferences.d.ts",
    "lib/types/client/index.d.ts",
    "lib/types/client/locales.d.ts",
    "cordis.patch.yml",
    "README.md",
    "ASSETS_LICENSE.md",
    "character-packs/default-whale/runtime/production-v1/**",
    "character-packs/default-whale/SOURCE.md",
    "character-packs/default-whale/LICENSE",
    "LICENSE"
  ],
  "license": "MIT",
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": ">=0.1.0-rc.5 <0.1.0-rc.8",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.5 <0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.1.0-rc.5 <0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.0-rc.5 <0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.5 <0.1.0-rc.8",
    "@deepseek-ai/dsh-credentials": ">=0.1.0-rc.5 <0.1.0-rc.8",
    "@deepseek-ai/dsh-invariants": ">=0.1.0-rc.5 <0.1.0-rc.8",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.5 <0.1.0-rc.8",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.5 <0.1.0-rc.8",
    "@deepseek-ai/dsh-session-projection": ">=0.1.0-rc.5 <0.1.0-rc.8",
    "@deepseek-ai/dsh-storage-domain": ">=0.1.0-rc.5 <0.1.0-rc.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.7",
    "@deepseek-ai/dsh-credentials": "0.1.0-rc.7",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.7",
    "@deepseek-ai/dsh-host-webserver": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session-projection": "0.1.0-rc.7",
    "@deepseek-ai/dsh-storage": "0.1.0-rc.7",
    "@deepseek-ai/dsh-storage-domain": "0.1.0-rc.7",
    "@deepseek-ai/dsh-storage-json": "0.1.0-rc.7",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@vitest/coverage-v8": "^4.1.8",
    "jsdom": "29.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
